{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "logs"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "grafana"
            },
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
              "type": "dashboard"
            }
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Off",
    "description": "Journald logs from the fleet, shipped by Grafana Alloy and stored in Loki. The error panel filters to error and warning priorities so a spike on the vitals or deploy panels can be traced to the lines that caused it; the host variable scopes both panels to one machine or the whole fleet.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Errors and warnings",
          "description": "Journald lines whose severity is error or warning. Severity comes from journald's priority, overridden at ingest by the application's own level (Python, .NET, Rust, shell, AdGuard, logfmt and PostgreSQL), so the panel filters on the level label instead of guessing from message text. Excluded as known benign: Nextcloud's caught PostgreSQL duplicate-key races, Loki's context-canceled query warnings, systemd-boot's generation version string warnings, WSL platform noise, and Tailscale's own upload, handshake and shutdown retries. The host variable scopes both panels to one machine or the whole fleet.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "{host=~\"$host\"} | level=~\"error|warn\" !~ \"duplicate key value violates unique constraint .(mounts_user_path_root_index|previews_file_uniq_idx|oc_filecache_extended_pkey).|not a valid version, accepting anyway|misc dxg:|WSL [(][0-9]+|fchmod[(][)] of /tmp/[.]X11-unix|Ignoring duplicate name|Failed to adjust io pressure threshold|regulatory[.]db|Speculative Return Stack Overflow|Failed to register legacy timer interrupt|setting up |grep: command not found|TPM: error opening|Imported /per/etc/ssh/|Can't ignore signal CHLD|amd_pstate:|device-mapper: core:|PCI: Fatal|PCI: System does not support PCI|vtcon0: Process|Activation request for 'org[.]freedesktop[.]resolve1' failed|Module rfkill failed to start|logrotate in debug mode|health[(]warnable=(warming-up|resolv-conf-overwritten)[)]|router: enumerating tailscale0 addresses|logtail:|http2: server: error reading preface|http: TLS handshake error|PollNetMap|lite map update error|ipnext: work queue shutdown failed|caller=(scheduler_processor|spanlogger)[.]go|error processing requests from scheduler|error notifying scheduler about finished query|failed mapping AST|closing iterator\"",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showLabels": false,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "All logs",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "{host=~\"$host\"}",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showLabels": false,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Journald",
              "collapse": false,
              "hideHeader": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 1,
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "tall",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "",
              "collapse": false,
              "hideHeader": true,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 1,
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "tall",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": ["logs"],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0
    },
    "title": "Logs",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "host",
          "current": {
            "text": ["All"],
            "value": ["$__all"]
          },
          "hide": "dontHide",
          "skipUrlSync": false,
          "label": "Host",
          "refresh": "onDashboardLoad",
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "loki"
            },
            "spec": {
              "query": "label_values(host)",
              "refId": "host-variable-query"
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "alphabeticalAsc",
          "definition": "label_values(host)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true,
          "allValue": ".+"
        }
      }
    ]
  }
}
