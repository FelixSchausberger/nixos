{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "logs"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "grafana"
            },
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
              "type": "dashboard"
            }
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Off",
    "description": "Journald logs from the fleet, shipped by Grafana Alloy and stored in Loki. The error panel filters to error and warning priorities so a spike on the vitals or deploy panels can be traced to the lines that caused it; the host variable scopes both panels to one machine or the whole fleet.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Errors and warnings",
          "description": "Journald lines that read like errors or warnings. The severity match is word-anchored so substrings such as fromAlert no longer match. Excluded as benign or upstream noise: ntfy's hourly 'Server stats' (emails_received_failure=0), Grafana's feature-flag 'flag evaluation succeeded' (ErrorCode/ErrorMessage fields), the backup job's rclone table header ('Elapsed time'), the Home Manager activation's own health-check status lines and mandb man-cache warnings, Nextcloud's caught PostgreSQL duplicate-key races (mounts_user_path_root_index, previews_file_uniq_idx, oc_filecache_extended_pkey), determinate-nixd's 'Unparsed Nix daemon log line', tailscaled's PCP probe against a router with PCP disabled, systemd's io-pressure warning on user-manager reexec, dbus-broker duplicate service names, and the log stores' own traces (logger=plugin.loki/tsdb.loki/query_data, caller=engine/roundtrip/metrics.go, Loki stream-flush lines) plus Loki's context-canceled query warnings.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "{host=~\"$host\"} |~ \"(?i)(^|[^a-z0-9_])(error|warn|fail|crit|emerg|alert)\" !~ \"emails_received_failure|flag evaluation|Elapsed time|emergency shell mechanisms|emergency mechanism tests|Checking critical dependencies|man-cache|mounts_user_path_root_index|previews_file_uniq_idx|oc_filecache_extended_pkey|Unparsed Nix daemon log line|portmapper: failed to get PCP mapping|Failed to adjust io pressure threshold|Ignoring duplicate name\" !~ \"logger=(plugin[.]loki|tsdb[.]loki|query_data)|caller=(engine|roundtrip|metrics)[.]go|flushing stream|failed mapping AST|error processing requests from scheduler|error notifying scheduler about finished query|closing iterator\"",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showLabels": false,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "All logs",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "{host=~\"$host\"}",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showLabels": false,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Journald",
              "collapse": false,
              "hideHeader": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 1,
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "tall",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "",
              "collapse": false,
              "hideHeader": true,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 1,
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "tall",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": ["logs"],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0
    },
    "title": "Logs",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "host",
          "current": {
            "text": ["All"],
            "value": ["$__all"]
          },
          "hide": "dontHide",
          "skipUrlSync": false,
          "label": "Host",
          "refresh": "onDashboardLoad",
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "loki"
            },
            "spec": {
              "query": "label_values(host)",
              "refId": "host-variable-query"
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "alphabeticalAsc",
          "definition": "label_values(host)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allowCustomValue": true,
          "allValue": ".+"
        }
      }
    ]
  }
}
