          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service_name, span_name) (rate(traces_span_metrics_duration_milliseconds_bucket[10m])))",
          "legendFormat": "{{service_name}} {{span_name}}",
          "range": true,
          "refId": "A"
        }
