#pretty
{
  alloy_aggregator_config = ''
    loki.relabel "journal" {
      forward_to = []
    
      rule {
        source_labels = ["__journal__systemd_unit"]
        target_label  = "unit"
      }
    
      rule {
        source_labels = ["__journal_priority_keyword"]
        target_label  = "level"
      }
    
      rule {
        source_labels = ["level"]
        regex         = "err|crit|alert|emerg"
        target_label  = "level"
        replacement   = "error"
      }
    
      rule {
        source_labels = ["level"]
        regex         = "warning"
        target_label  = "level"
        replacement   = "warn"
      }
    
      rule {
        source_labels = ["level"]
        regex         = "notice"
        target_label  = "level"
        replacement   = "info"
      }
    
      // The capture group is load-bearing: relabel's default replacement is
      // `$1`, so a bare `.+` matches but expands to an empty label value.
      // Systems units have no user unit and do not match at all.
      rule {
        source_labels = ["__journal__systemd_user_unit"]
        regex         = "(.+)"
        target_label  = "user_unit"
      }
    }
    
    loki.process "levels" {
      forward_to = [loki.write.loki.receiver]
    
      // logfmt shape: `level=error`, `level="warning"`, `level=DEBUG`.
      stage.regex {
        expression = "(?i)(?:^|\\s)level=(?P<app_level>error|warn(?:ing)?|info|debug|trace|fatal|crit(?:ical)?|alert|emerg|notice)\\b"
      }
    
      // Python logging (`%asctime - %name - LEVEL - message`), the shape
      // OctoPrint and most Python services print to stderr.
      stage.regex {
        expression = " - (?P<app_level>DEBUG|INFO|WARNING|WARN|ERROR|CRITICAL) - "
      }
    
      // Jellyfin/.NET prefixes each line with a three-letter level.
      stage.regex {
        expression = "\\[(?P<app_level>ERR|WRN|INF|DBG|FTL|TRC)\\]"
      }
    
      // Rust env_logger (Vaultwarden): `[timestamp][error][ERROR]`.
      stage.regex {
        expression = "\\]\\[(?P<app_level>error|warn|info|debug|trace)\\]"
      }
    
      // Shell health checks emit `ERROR:`/`WARNING:` at line start;
      // wallpaper-conditions writes `WARNING ...` without the colon.
      stage.regex {
        expression = "^(?P<app_level>ERROR|WARNING|CRITICAL)\\b"
      }
    
      // AdGuard Home: `2026/11/25 10:00:00 [error] ...`.
      stage.regex {
        expression = "^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9:]+ \\[(?P<app_level>error|warning|info|debug)\\]"
      }
    
      // `with .Value` keeps a non-matching line from acquiring an empty
      // app_level, which the labels stage would otherwise write as level="".
      stage.template {
        source   = "app_level"
        template = "{{ with .Value }}{{ $l := . | ToLower }}{{ if or (eq $l \"warning\") (eq $l \"wrn\") }}warn{{ else if or (eq $l \"fatal\") (eq $l \"critical\") (eq $l \"crit\") (eq $l \"alert\") (eq $l \"emerg\") (eq $l \"err\") (eq $l \"ftl\") }}error{{ else if or (eq $l \"notice\") (eq $l \"inf\") }}info{{ else if eq $l \"trc\" }}trace{{ else if eq $l \"dbg\" }}debug{{ else }}{{ $l }}{{ end }}{{ end }}"
      }
    
      stage.labels {
        values = { level = "app_level" }
      }
    
      // Postgres writes `[pid] ERROR: ...` to stderr without a level prefix;
      // this is the shape behind the oc_mounts duplicate-key flood.
      stage.regex {
        expression = "^\\[[0-9]+\\] (?P<pg_level>ERROR|FATAL|PANIC|WARNING|NOTICE|INFO|LOG|DEBUG[1-5]?|STATEMENT|DETAIL|HINT):"
      }
    
      stage.template {
        source   = "pg_level"
        template = "{{ with .Value }}{{ if eq . \"WARNING\" }}warn{{ else if or (eq . \"ERROR\") (eq . \"FATAL\") (eq . \"PANIC\") }}error{{ else }}info{{ end }}{{ end }}"
      }
    
      stage.labels {
        values = { level = "pg_level" }
      }
    }
    
    loki.source.journal "journal" {
      forward_to    = [loki.process.levels.receiver]
      relabel_rules = loki.relabel.journal.rules
      labels        = {host = "m920q"}
      max_age       = "24h"
    }
    
    loki.source.syslog "slzb" {
      listener {
        address       = "0.0.0.0:1514"
        protocol      = "udp"
        syslog_format = "rfc3164"
        labels        = {job = "syslog", device = "slzb-mr4u", host = "m920q"}
      }
    
      forward_to = [loki.process.levels.receiver]
    }
    
    
    loki.write "loki" {
      endpoint {
        url = "http://127.0.0.1:3100/loki/api/v1/push"
      }
    }
  '';
  alloy_aggregator_enabled = true;
  desktop_alloy_enabled = true;
  desktop_loki_enabled = false;
  desktop_ship_endpoint = "http://m920q:3100";
  firewall_extra_input_rules = ''
    ip saddr 192.168.178.72 tcp dport 8123 accept
    ip saddr 192.168.178.3 tcp dport 3100 accept
    ip saddr 192.168.178.74 udp dport 1514 accept'';
  grafana_datasources = [
    "prometheus"
    "loki"
    "garmin_influxdb"
  ];
  logs_dashboard_provisioned = true;
  loki_client_sources = [
    "192.168.178.3"
  ];
  loki_enabled = true;
  loki_http_listen_address = "0.0.0.0";
  loki_log_level = "warn";
  loki_port = 3100;
  loki_retention = "30d";
  surface_alloy_enabled = true;
  surface_loki_enabled = false;
  surface_ship_endpoint = "http://m920q.tailf2f0ca.ts.net:3100";
  syslog_port = 1514;
  syslog_source = "192.168.178.74";
}