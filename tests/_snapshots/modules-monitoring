#pretty
{
  alertmanager = {
    alertmanager_targets = [
      "127.0.0.1:9093"
    ];
    receiver = {
      name = "ntfy";
      send_resolved = true;
      url = "http://127.0.0.1:8000/hook";
    };
    route = {
      group_by = [
        "alertname"
        "host"
      ];
      group_interval = "5m";
      group_wait = "30s";
      receiver = "ntfy";
      repeat_interval = "4h";
    };
  };
  alertmanager_ntfy = {
    headers = {
      X-Click = "{{ .GeneratorURL }}";
      X-Markdown = "yes";
    };
    priority = "status == \"resolved\" ? \"default\" : alert.labels.priority";
    tags = [
      {
        condition = "status == \"firing\"";
        tag = "rotating_light";
      }
      {
        condition = "status == \"resolved\"";
        tag = "white_check_mark";
      }
    ];
    title = "{{ if eq .Status \"resolved\" }}Resolved: {{ end }}{{ index .Labels \"alertname\" }} on {{ index .Labels \"host\" }}";
    topic = "homelab-alerts";
  };
  dashboard_providers = [
    "fritz"
    "config-health"
    "nix-otel"
    "garmin"
  ];
  rule_count = 19;
  rules = [
    {
      alert = "NextcloudDown";
      expr = "probe_success{job=\"blackbox\",app=\"nextcloud\"} == 0";
      priority = "urgent";
    }
    {
      alert = "ImmichDown";
      expr = "probe_success{job=\"blackbox\",app=\"immich\"} == 0";
      priority = "urgent";
    }
    {
      alert = "JellyfinDown";
      expr = "probe_success{job=\"blackbox\",app=\"jellyfin\"} == 0";
      priority = "urgent";
    }
    {
      alert = "NavidromeDown";
      expr = "probe_success{job=\"blackbox\",app=\"navidrome\"} == 0";
      priority = "urgent";
    }
    {
      alert = "VaultwardenDown";
      expr = "probe_success{job=\"blackbox\",app=\"vaultwarden\"} == 0";
      priority = "urgent";
    }
    {
      alert = "AdGuardDown";
      expr = "up{job=\"adguard\"} == 0 or adguard_running == 0";
      priority = "urgent";
    }
    {
      alert = "DnsResolutionFailed";
      expr = "probe_success{job=\"blackbox-dns\"} == 0";
      priority = "urgent";
    }
    {
      alert = "BackupFailed";
      expr = "node_systemd_unit_state{name=~\".*(sanoid|syncoid).*[.]service\",state=\"failed\"} == 1";
      priority = "high";
    }
    {
      alert = "FritzboxWanDown";
      expr = "fritz_wan_phys_link_status == 0";
      priority = "urgent";
    }
    {
      alert = "WanUnreachable";
      expr = "probe_success{job=\"blackbox-icmp\"} == 0";
      priority = "urgent";
    }
    {
      alert = "WanHighLatency";
      expr = "probe_duration_seconds{job=\"blackbox-icmp\"} > 0.5";
      priority = "high";
    }
    {
      alert = "NodeExporterDown";
      expr = "up{job=\"node\"} == 0";
      priority = "urgent";
    }
    {
      alert = "FilesystemFull";
      expr = "(node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"}) < 0.1 and node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"} > 2e9";
      priority = "urgent";
    }
    {
      alert = "FilesystemWarn";
      expr = "(node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"}) < 0.2 and node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"} > 2e9";
      priority = "high";
    }
    {
      alert = "NixdGcStorm";
      expr = "nixd_gc_runs_last_90min > 3";
      priority = "high";
    }
    {
      alert = "ServiceFailed";
      expr = "node_systemd_unit_state{state=\"failed\"} == 1";
      priority = "high";
    }
    {
      alert = "MemoryPressure";
      expr = "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 0.1";
      priority = "high";
    }
    {
      alert = "CpuTemperature";
      expr = "node_thermal_zone_temp{type=\"x86_pkg_temp\"} >= 90";
      priority = "urgent";
    }
    {
      alert = "PostgresDown";
      expr = "up{job=\"postgres\"} == 0";
      priority = "high";
    }
  ];
  scrape_hosts = [
    "desktop"
    "m920q"
  ];
  scrape_jobs = [
    "node"
    "node-desktop"
    "postgres"
    "otel"
    "vitals"
    "fritz"
    "nextcloud-exporter"
    "adguard"
    "blackbox"
    "blackbox-dns"
    "blackbox-icmp"
  ];
  vitals_scrape_enabled = true;
}