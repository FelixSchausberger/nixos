#pretty
{
  contact_point = {
    disable_resolve_message = false;
    name = "ntfy";
    priority_templated = true;
    topic_in_payload = true;
    type = "webhook";
    url = "http://127.0.0.1:2586/";
  };
  expected_rules = [
    "fritzbox-wan-down"
    "wan-unreachable"
    "wan-high-latency"
    "node-exporter-down"
    "nixd-gc-storm"
    "postgres-down"
    "filesystem-full"
    "nextcloud-down"
    "immich-down"
    "jellyfin-down"
    "adguard-down"
    "dns-resolution-failed"
    "backup-failed"
  ];
  folder = "Homelab";
  interval = "2m";
  policy = {
    group_by = [ ];
    group_interval = "5m";
    group_wait = "30s";
    repeat_interval = "4h";
  };
  rule_count = 14;
  rules = [
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "probe_success{job=\"blackbox\",app=\"nextcloud\"} == bool 0";
      noDataState = "Alerting";
      severity = "urgent";
      title = "NextcloudDown";
      uid = "nextcloud-down";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "probe_success{job=\"blackbox\",app=\"immich\"} == bool 0";
      noDataState = "Alerting";
      severity = "urgent";
      title = "ImmichDown";
      uid = "immich-down";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "probe_success{job=\"blackbox\",app=\"jellyfin\"} == bool 0";
      noDataState = "Alerting";
      severity = "urgent";
      title = "JellyfinDown";
      uid = "jellyfin-down";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "up{job=\"adguard\"} == bool 0 or adguard_running == bool 0";
      noDataState = "Alerting";
      severity = "urgent";
      title = "AdGuardDown";
      uid = "adguard-down";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "node_systemd_unit_state{name=~\".*(sanoid|syncoid).*[.]service\",state=\"failed\"} == bool 1";
      noDataState = "Alerting";
      severity = "high";
      title = "BackupFailed";
      uid = "backup-failed";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "fritz_wan_phys_link_status == bool 0";
      noDataState = "Alerting";
      severity = "urgent";
      title = "FritzboxWanDown";
      uid = "fritzbox-wan-down";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "probe_success{job=\"blackbox-dns\"} == bool 0";
      noDataState = "Alerting";
      severity = "urgent";
      title = "DnsResolutionFailed";
      uid = "dns-resolution-failed";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "probe_success{job=\"blackbox-icmp\"} == bool 0";
      noDataState = "Alerting";
      severity = "urgent";
      title = "WanUnreachable";
      uid = "wan-unreachable";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "probe_duration_seconds{job=\"blackbox-icmp\"} > bool 0.5";
      noDataState = "Alerting";
      severity = "high";
      title = "WanHighLatency";
      uid = "wan-high-latency";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "up{job=\"node\"} == bool 0";
      noDataState = "Alerting";
      severity = "urgent";
      title = "NodeExporterDown";
      uid = "node-exporter-down";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "nixd_gc_runs_last_90min > bool 3";
      noDataState = "OK";
      severity = "high";
      title = "NixdGcStorm";
      uid = "nixd-gc-storm";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "up{job=\"postgres\"} == bool 0";
      noDataState = "Alerting";
      severity = "high";
      title = "PostgresDown";
      uid = "postgres-down";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "(node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"}) < bool 0.1";
      noDataState = "Alerting";
      severity = "urgent";
      title = "FilesystemFull";
      uid = "filesystem-full";
    }
    {
      datasource_uid = "prometheus";
      execErrState = "KeepLast";
      expr = "(node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|devtmpfs|efivarfs|iso9660|mqueue|hugetlbfs\"}) < bool 0.2";
      noDataState = "Alerting";
      severity = "high";
      title = "FilesystemWarn";
      uid = "filesystem-warning";
    }
  ];
}