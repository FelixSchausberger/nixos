{pkgs, ...}: {
  imports = [
    ../../../modules/home/gui/browsers
    ../../persistence.nix
  ];

  # m920q niri specialisation: minimal GUI config for occasional desktop use.
  # Monitor auto-detection used since output names vary (HDMI-A-1, DP-1, etc.).

  # Session start is handled system-side: greetd autologin runs niri-session
  # (see hosts/m920q/default.nix). No shell-level session bootstrap needed.

  wm.niri = {
    enable = true;
    browser = "zen";
    terminal = "ghostty";
    # VIRTUAL-1 is the vkms headless output; disable it in GUI mode so content stays on projector.
    outputs = [
      {
        name = "VIRTUAL-1";
        enable = false;
      }
    ];
    windowRules = [
      # Moonlight streams on the projector only; always fullscreen there.
      {
        matches = [{app-id = "^moonlight$";}];
        open-fullscreen = true;
      }
    ];
  };

  home.packages = with pkgs; [
    moonlight-qt
  ];
}
